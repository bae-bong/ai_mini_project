# Copy to .env; never commit real credentials.
# Local preview only. Public HTTPS deployment is a separate integration step.
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
POSTGRES_DB=ai_mini_project
POSTGRES_USER=app
POSTGRES_PASSWORD=

# Required by auth and RAG; use the same secret for both.
JWT_SECRET=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-ada-002
# Leave empty for the model's default dimensions.
EMBEDDING_DIMENSIONS=
